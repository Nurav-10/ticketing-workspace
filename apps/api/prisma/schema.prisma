generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model LoginTransaction {
  handleHash        Bytes    @id @map("handle_hash") @db.ByteA
  encryptedPayload  Bytes    @map("encrypted_payload") @db.ByteA
  encryptionIv      Bytes    @map("encryption_iv") @db.ByteA
  authenticationTag Bytes    @map("authentication_tag") @db.ByteA
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "login_transactions_expires_at_idx")
  @@map("login_transactions")
}

model User {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerSubject String?                @unique(map: "users_provider_subject_key") @map("provider_subject")
  email           String
  emailVerifiedAt DateTime?              @map("email_verified_at") @db.Timestamptz(6)
  displayName     String                 @map("display_name")
  status          String                 @default("active")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  memberships     WorkspaceMembership[]
  invitations     Invitation[]           @relation("InvitationInviter")
  sessions        AppSession[]
  identities      UserIdentity[]
  securityAuditEvents SecurityAuditEvent[] @relation("SecurityAuditActor")
  assignedIssues     Issue[]               @relation("IssueAssignee")
  createdIssues      Issue[]               @relation("IssueCreator")
  issueActivityEvents IssueActivityEvent[]  @relation("IssueActivityActor")
  issueIdempotencyRecords IssueIdempotencyRecord[] @relation("IssueIdempotencyActor")
  authoredComments Comment[] @relation("CommentAuthor")
  createdProjects Project[]
  createdCycles Cycle[]

  @@map("users")
}

model AppSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  tokenHash        Bytes    @unique(map: "app_sessions_token_hash_key") @map("token_hash") @db.ByteA
  createdAt        DateTime @map("created_at") @db.Timestamptz(6)
  lastSeenAt       DateTime @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt    DateTime @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?  @map("revoke_reason")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "app_sessions_user_id_fkey")

  @@index([userId], map: "app_sessions_user_id_idx")
  @@map("app_sessions")
}

model UserIdentity {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  issuer                String
  subject               String
  providerEmail         String?  @map("provider_email")
  providerEmailVerified Boolean  @default(false) @map("provider_email_verified")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastAuthenticatedAt   DateTime @default(now()) @map("last_authenticated_at") @db.Timestamptz(6)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_identities_user_id_fkey")

  @@unique([issuer, subject], map: "user_identities_issuer_subject_key")
  @@index([userId], map: "user_identities_user_id_idx")
  @@map("user_identities")
}

model SchemaMigration {
  name      String   @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_migrations")
}

model RateLimitCounter {
  operation      String
  identifierHash Bytes    @map("identifier_hash") @db.ByteA
  windowStart    DateTime @map("window_start") @db.Timestamptz(3)
  windowMs       Int      @map("window_ms")
  hitCount       BigInt   @map("hit_count") @db.BigInt
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([operation, identifierHash, windowStart, windowMs], map: "rate_limit_counters_pkey")
  @@index([expiresAt], map: "rate_limit_counters_expires_at_idx")
  @@map("rate_limit_counters")
}

model Workspace {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String                 @unique(map: "workspaces_slug_key")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  memberships WorkspaceMembership[]
  teams       Team[]
  invitations Invitation[]
  auditEvents SecurityAuditEvent[]
  issues      Issue[]
  issueActivityEvents IssueActivityEvent[]
  outboxEvents OutboxEvent[]
  outboxSequence WorkspaceOutboxSequence?
  issueIdempotencyRecords IssueIdempotencyRecord[]
  comments Comment[]
  projects Project[]
  cycles Cycle[]
  workflowStatuses WorkflowStatus[]
  workflowTransitions WorkflowTransition[]

  @@map("workspaces")
}

enum SecurityAuditEventKind {
  workspace_invitation_created
  workspace_invitation_revoked
  workspace_invitation_redeemed
  workspace_membership_added
  workspace_membership_removed
  workspace_membership_role_changed
  workspace_owner_transferred
  team_created
  team_updated
  team_deleted
  team_membership_added
  team_membership_removed

  @@map("security_audit_event_kind")
}

model SecurityAuditEvent {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String                 @map("workspace_id") @db.Uuid
  actorUserId String?                @map("actor_user_id") @db.Uuid
  eventKind   SecurityAuditEventKind @map("event_kind")
  metadata    Json                   @db.JsonB
  createdAt   DateTime               @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict, map: "security_audit_events_workspace_id_fkey")
  actor       User?                  @relation("SecurityAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "security_audit_events_actor_user_id_fkey")

  @@index([workspaceId, createdAt(sort: Desc)], map: "security_audit_events_workspace_created_at_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "security_audit_events_actor_created_at_idx")
  @@map("security_audit_events")
}

model WorkspaceMembership {
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "workspace_memberships_workspace_id_fkey")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "workspace_memberships_user_id_fkey")
  teams       TeamMembership[]

  @@id([workspaceId, userId], map: "workspace_memberships_pkey")
  @@unique([workspaceId, userId, role], map: "workspace_memberships_workspace_id_user_id_role_key")
  @@map("workspace_memberships")
}

model Team {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  name        String
  key         String
  visibility  String           @default("workspace")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "teams_workspace_id_fkey")
  memberships TeamMembership[]
  nextIssueNumber Int @default(1) @map("next_issue_number")
  workflowVersion Int @default(1) @map("workflow_version")
  issueQueryVersion BigInt @default(1) @map("issue_query_version") @db.BigInt
  issues Issue[]
  issueActivityEvents IssueActivityEvent[]
  outboxEvents OutboxEvent[]
  comments Comment[]
  projects Project[]
  cycles Cycle[]
  workflowStatuses WorkflowStatus[]
  workflowTransitions WorkflowTransition[]
  labels Label[]

  @@unique([workspaceId, id], map: "teams_workspace_id_id_key")
  @@unique([workspaceId, key], map: "teams_workspace_id_key_key")
  @@map("teams")
}

enum IssueStatus {
  backlog
  todo
  in_progress
  done
  canceled

  @@map("issue_status")
}

enum IssuePriority {
  none
  low
  medium
  high
  urgent

  @@map("issue_priority")
}

enum IssueActivityKind {
  created
  fields_changed
  status_changed
  archived
  restored
  comment_created
  comment_edited
  comment_deleted
  project_changed
  cycle_changed
  labels_changed

  @@map("issue_activity_kind")
}

model Issue {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  issueNumber Int @map("issue_number")
  title String @db.VarChar(250)
  description String? @db.VarChar(20000)
  status IssueStatus @default(backlog)
  workflowStatusId String? @map("workflow_status_id") @db.Uuid
  priority IssuePriority @default(none)
  assigneeUserId String? @map("assignee_user_id") @db.Uuid
  createdByUserId String @map("created_by_user_id") @db.Uuid
  version Int @default(1)
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, map: "issues_workspace_id_fkey")
  team Team @relation(fields: [workspaceId, teamId], references: [workspaceId, id], onDelete: Restrict, map: "issues_workspace_id_team_id_fkey")
  workflowStatus WorkflowStatus? @relation(fields: [workspaceId, teamId, workflowStatusId], references: [workspaceId, teamId, id], onDelete: Restrict, map: "issues_workspace_id_team_id_workflow_status_id_fkey")
  assignee User? @relation("IssueAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict, map: "issues_assignee_user_id_fkey")
  creator User @relation("IssueCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "issues_created_by_user_id_fkey")
  activityEvents IssueActivityEvent[]
  outboxEvents OutboxEvent[]
  idempotencyRecords IssueIdempotencyRecord[]
  comments Comment[]
  labels IssueLabel[]
  project Project? @relation(fields: [workspaceId, teamId, projectId], references: [workspaceId, teamId, id], onDelete: Restrict, map: "issues_workspace_team_project_fkey")
  cycle Cycle? @relation(fields: [workspaceId, teamId, cycleId], references: [workspaceId, teamId, id], onDelete: Restrict, map: "issues_workspace_team_cycle_fkey")
  projectId String? @map("project_id") @db.Uuid
  cycleId String? @map("cycle_id") @db.Uuid

  @@unique([teamId, issueNumber], map: "issues_team_id_issue_number_key")
  @@unique([workspaceId, teamId, id], map: "issues_workspace_id_team_id_id_key")
  @@unique([workspaceId, id], map: "issues_workspace_id_id_key")
  @@index([workspaceId, teamId, createdAt(sort: Desc), id(sort: Desc)], map: "issues_team_created_at_id_idx")
  @@index([workspaceId, teamId, status, createdAt(sort: Desc), id(sort: Desc)], map: "issues_team_status_created_at_id_idx")
  @@index([workspaceId, teamId, workflowStatusId], map: "issues_team_workflow_status_idx")
  @@index([workspaceId, teamId, priority, createdAt(sort: Desc), id(sort: Desc)], map: "issues_team_priority_created_at_id_idx")
  @@index([workspaceId, assigneeUserId], map: "issues_workspace_assignee_idx")
  @@index([workspaceId, teamId, projectId], map: "issues_team_project_idx")
  @@index([workspaceId, teamId, cycleId], map: "issues_team_cycle_idx")
  @@map("issues")
}

model Label {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  name String @db.VarChar(50)
  normalizedName String @map("normalized_name") @db.VarChar(50)
  color String @default("#6b7280") @db.VarChar(7)
  version Int @default(1)
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  team Team @relation(fields: [workspaceId, teamId], references: [workspaceId, id], onDelete: Restrict, map: "labels_workspace_id_team_id_fkey")
  issues IssueLabel[]

  @@unique([workspaceId, teamId, id], map: "labels_workspace_id_team_id_id_key")
  @@unique([workspaceId, teamId, normalizedName], map: "labels_workspace_id_team_id_normalized_name_key")
  @@index([workspaceId, teamId, createdAt(sort: Desc), id(sort: Desc)], map: "labels_team_created_idx")
  @@map("labels")
}

model IssueLabel {
  workspaceId String @map("workspace_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  issueId String @map("issue_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  issue Issue @relation(fields: [workspaceId, teamId, issueId], references: [workspaceId, teamId, id], onDelete: Cascade, map: "issue_labels_workspace_id_team_id_issue_id_fkey")
  label Label @relation(fields: [workspaceId, teamId, labelId], references: [workspaceId, teamId, id], onDelete: Restrict, map: "issue_labels_workspace_id_team_id_label_id_fkey")

  @@id([workspaceId, teamId, issueId, labelId], map: "issue_labels_pkey")
  @@index([workspaceId, teamId, labelId, issueId], map: "issue_labels_label_lookup_idx")
  @@map("issue_labels")
}

enum CommentContentFormat {
  plain_text

  @@map("comment_content_format")
}

model Comment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  issueId String @map("issue_id") @db.Uuid
  authorUserId String @map("author_user_id") @db.Uuid
  body String? @db.VarChar(10000)
  contentFormat CommentContentFormat @default(plain_text) @map("content_format")
  version Int @default(1)
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  editedAt DateTime? @map("edited_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, map: "comments_workspace_id_fkey")
  team Team @relation(fields: [workspaceId, teamId], references: [workspaceId, id], onDelete: Restrict, map: "comments_workspace_id_team_id_fkey")
  issue Issue @relation(fields: [workspaceId, teamId, issueId], references: [workspaceId, teamId, id], onDelete: Restrict, map: "comments_workspace_id_team_id_issue_id_fkey")
  author User @relation("CommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict, map: "comments_author_user_id_fkey")

  @@index([workspaceId, teamId, issueId, createdAt, id], map: "comments_issue_created_id_idx")
  @@index([authorUserId, createdAt], map: "comments_author_idx")
  @@map("comments")
}

enum ProjectStatus {
  planned
  in_progress
  completed
  canceled

  @@map("project_status")
}

enum CycleStatus {
  planned
  active
  completed

  @@map("cycle_status")
}

model Project {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  name String @db.VarChar(120)
  description String? @db.VarChar(5000)
  status ProjectStatus @default(planned)
  startAt DateTime? @map("start_at") @db.Timestamptz(6)
  targetAt DateTime? @map("target_at") @db.Timestamptz(6)
  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, map: "projects_workspace_id_fkey")
  team Team @relation(fields: [workspaceId, teamId], references: [workspaceId, id], onDelete: Restrict, map: "projects_workspace_team_fkey")
  creator User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, map: "projects_creator_id_fkey")
  issues Issue[]
  @@unique([workspaceId, teamId, id], map: "projects_workspace_team_id_key")
  @@index([workspaceId, teamId, status, createdAt(sort: Desc)], map: "projects_team_status_created_idx")
  @@map("projects")
}

model Cycle {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  name String @db.VarChar(120)
  startAt DateTime @map("start_at") @db.Timestamptz(6)
  endAt DateTime @map("end_at") @db.Timestamptz(6)
  status CycleStatus @default(planned)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, map: "cycles_workspace_id_fkey")
  team Team @relation(fields: [workspaceId, teamId], references: [workspaceId, id], onDelete: Restrict, map: "cycles_workspace_team_fkey")
  creator User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, map: "cycles_creator_id_fkey")
  issues Issue[]
  @@unique([workspaceId, teamId, id], map: "cycles_workspace_team_id_key")
  @@index([workspaceId, teamId, startAt], map: "cycles_team_start_idx")
  @@map("cycles")
}

enum WorkflowStatusCategory {
  backlog
  unstarted
  started
  completed
  canceled

  @@map("workflow_status_category")
}

model WorkflowStatus {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String                 @map("workspace_id") @db.Uuid
  teamId         String                 @map("team_id") @db.Uuid
  key            String                 @db.VarChar(64)
  name           String                 @db.VarChar(100)
  category       WorkflowStatusCategory
  position       Int
  isDefault      Boolean                @default(false) @map("is_default")
  isRetired      Boolean                @default(false) @map("is_retired")
  createdAt      DateTime               @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "workflow_statuses_workspace_id_fkey")
  team           Team                   @relation(fields: [workspaceId, teamId], references: [workspaceId, id], onDelete: Cascade, map: "workflow_statuses_workspace_id_team_id_fkey")
  issues         Issue[]
  outgoingTransitions WorkflowTransition[] @relation("WorkflowTransitionSource")
  incomingTransitions WorkflowTransition[] @relation("WorkflowTransitionTarget")

  @@unique([teamId, key], map: "workflow_statuses_team_id_key_key")
  @@unique([workspaceId, teamId, id], map: "workflow_statuses_workspace_id_team_id_id_key")
  @@index([workspaceId, teamId, isRetired, position], map: "workflow_statuses_team_retired_position_idx")
  @@map("workflow_statuses")
}

model WorkflowTransition {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  teamId         String         @map("team_id") @db.Uuid
  sourceStatusId String         @map("source_status_id") @db.Uuid
  targetStatusId String         @map("target_status_id") @db.Uuid
  createdAt      DateTime       @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "workflow_transitions_workspace_id_fkey")
  team           Team           @relation(fields: [workspaceId, teamId], references: [workspaceId, id], onDelete: Cascade, map: "workflow_transitions_workspace_id_team_id_fkey")
  sourceStatus   WorkflowStatus @relation("WorkflowTransitionSource", fields: [workspaceId, teamId, sourceStatusId], references: [workspaceId, teamId, id], onDelete: Cascade, map: "workflow_transitions_source_status_fkey")
  targetStatus   WorkflowStatus @relation("WorkflowTransitionTarget", fields: [workspaceId, teamId, targetStatusId], references: [workspaceId, teamId, id], onDelete: Cascade, map: "workflow_transitions_target_status_fkey")

  @@unique([teamId, sourceStatusId, targetStatusId], map: "workflow_transitions_team_source_target_key")
  @@index([teamId, sourceStatusId], map: "workflow_transitions_team_source_idx")
  @@map("workflow_transitions")
}

model IssueActivityEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  issueId String @map("issue_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  eventKind IssueActivityKind @map("event_kind")
  metadata Json @db.JsonB
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, map: "issue_activity_events_workspace_id_fkey")
  team Team @relation(fields: [workspaceId, teamId], references: [workspaceId, id], onDelete: Restrict, map: "issue_activity_events_workspace_id_team_id_fkey")
  issue Issue @relation(fields: [workspaceId, teamId, issueId], references: [workspaceId, teamId, id], onDelete: Restrict, map: "issue_activity_events_workspace_id_team_id_issue_id_fkey")
  actor User @relation("IssueActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "issue_activity_events_actor_user_id_fkey")

  @@index([issueId, createdAt, id], map: "issue_activity_events_issue_created_at_id_idx")
  @@index([workspaceId, createdAt], map: "issue_activity_events_workspace_created_at_idx")
  @@map("issue_activity_events")
}

model OutboxEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  issueId String @map("issue_id") @db.Uuid
  eventKind String @map("event_kind") @db.VarChar(64)
  schemaVersion Int @default(1) @map("schema_version")
  payload Json @db.JsonB
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  retryCount Int @default(0) @map("retry_count")
  nextAttemptAt DateTime @default(dbgenerated("clock_timestamp()")) @map("next_attempt_at") @db.Timestamptz(6)
  claimedBy String? @map("claimed_by") @db.VarChar(255)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)
  deadLetterReason String? @map("dead_letter_reason")
  lastError String? @map("last_error")
  workspaceSequence BigInt? @map("workspace_sequence")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, map: "outbox_events_workspace_id_fkey")
  team Team @relation(fields: [workspaceId, teamId], references: [workspaceId, id], onDelete: Restrict, map: "outbox_events_workspace_id_team_id_fkey")
  issue Issue @relation(fields: [workspaceId, teamId, issueId], references: [workspaceId, teamId, id], onDelete: Restrict, map: "outbox_events_workspace_id_team_id_issue_id_fkey")

  @@index([nextAttemptAt, createdAt], map: "outbox_events_pending_idx")
  @@index([nextAttemptAt, createdAt], map: "outbox_events_claim_idx")
  @@index([leaseExpiresAt], map: "outbox_events_lease_idx")
  @@index([workspaceId, deadLetteredAt], map: "outbox_events_dead_letter_idx")
  @@map("outbox_events")
}

model WorkspaceOutboxSequence {
  workspaceId String @id @map("workspace_id") @db.Uuid
  nextSequence BigInt @default(1) @map("next_sequence")
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, map: "workspace_outbox_sequences_workspace_id_fkey")

  @@map("workspace_outbox_sequences")
}

model IssueIdempotencyRecord {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  operation String @db.VarChar(64)
  key String @db.VarChar(255)
  payloadHash Bytes @map("payload_hash") @db.ByteA
  issueId String @map("issue_id") @db.Uuid
  response Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP + interval '24 hours'")) @map("expires_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, map: "issue_idempotency_records_workspace_id_fkey")
  actor User @relation("IssueIdempotencyActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "issue_idempotency_records_actor_user_id_fkey")
  issue Issue @relation(fields: [workspaceId, teamId, issueId], references: [workspaceId, teamId, id], onDelete: Restrict, map: "issue_idempotency_records_workspace_id_team_id_issue_id_fkey")

  @@unique([workspaceId, actorUserId, operation, key], map: "issue_idempotency_records_scope_key")
  @@index([expiresAt], map: "issue_idempotency_records_expires_at_idx")
  @@map("issue_idempotency_records")
}

model TeamMembership {
  workspaceId String @map("workspace_id") @db.Uuid
  teamId      String @map("team_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  team        Team @relation(fields: [workspaceId, teamId], references: [workspaceId, id], onDelete: Cascade, map: "team_memberships_workspace_id_team_id_fkey")
  membership  WorkspaceMembership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade, map: "team_memberships_workspace_id_user_id_fkey")

  @@id([teamId, userId], map: "team_memberships_pkey")
  @@map("team_memberships")
}

model Invitation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  email      String
  role       String
  tokenHash  Bytes    @unique(map: "invitations_token_hash_key") @map("token_hash") @db.ByteA
  invitedBy  String   @map("invited_by") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  redeemedAt DateTime? @map("redeemed_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "invitations_workspace_id_fkey")
  inviter    User      @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: NoAction, map: "invitations_invited_by_fkey")

  @@map("invitations")
}
