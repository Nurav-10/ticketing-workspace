generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model LoginTransaction {
  handleHash        Bytes    @id @map("handle_hash") @db.ByteA
  encryptedPayload  Bytes    @map("encrypted_payload") @db.ByteA
  encryptionIv      Bytes    @map("encryption_iv") @db.ByteA
  authenticationTag Bytes    @map("authentication_tag") @db.ByteA
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "login_transactions_expires_at_idx")
  @@map("login_transactions")
}

model User {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerSubject String?                @unique(map: "users_provider_subject_key") @map("provider_subject")
  email           String
  emailVerifiedAt DateTime?              @map("email_verified_at") @db.Timestamptz(6)
  displayName     String                 @map("display_name")
  status          String                 @default("active")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  memberships     WorkspaceMembership[]
  invitations     Invitation[]           @relation("InvitationInviter")
  sessions        AppSession[]
  identities      UserIdentity[]
  securityAuditEvents SecurityAuditEvent[] @relation("SecurityAuditActor")

  @@map("users")
}

model AppSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  tokenHash        Bytes    @unique(map: "app_sessions_token_hash_key") @map("token_hash") @db.ByteA
  createdAt        DateTime @map("created_at") @db.Timestamptz(6)
  lastSeenAt       DateTime @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt    DateTime @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?  @map("revoke_reason")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "app_sessions_user_id_fkey")

  @@index([userId], map: "app_sessions_user_id_idx")
  @@map("app_sessions")
}

model UserIdentity {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  issuer                String
  subject               String
  providerEmail         String?  @map("provider_email")
  providerEmailVerified Boolean  @default(false) @map("provider_email_verified")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastAuthenticatedAt   DateTime @default(now()) @map("last_authenticated_at") @db.Timestamptz(6)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_identities_user_id_fkey")

  @@unique([issuer, subject], map: "user_identities_issuer_subject_key")
  @@index([userId], map: "user_identities_user_id_idx")
  @@map("user_identities")
}

model SchemaMigration {
  name      String   @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_migrations")
}

model RateLimitCounter {
  operation      String
  identifierHash Bytes    @map("identifier_hash") @db.ByteA
  windowStart    DateTime @map("window_start") @db.Timestamptz(3)
  windowMs       Int      @map("window_ms")
  hitCount       BigInt   @map("hit_count") @db.BigInt
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([operation, identifierHash, windowStart, windowMs], map: "rate_limit_counters_pkey")
  @@index([expiresAt], map: "rate_limit_counters_expires_at_idx")
  @@map("rate_limit_counters")
}

model Workspace {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String                 @unique(map: "workspaces_slug_key")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  memberships WorkspaceMembership[]
  teams       Team[]
  invitations Invitation[]
  auditEvents SecurityAuditEvent[]

  @@map("workspaces")
}

enum SecurityAuditEventKind {
  workspace_invitation_created
  workspace_invitation_revoked
  workspace_invitation_redeemed
  workspace_membership_added
  workspace_membership_removed
  workspace_membership_role_changed
  workspace_owner_transferred
  team_created
  team_updated
  team_deleted
  team_membership_added
  team_membership_removed

  @@map("security_audit_event_kind")
}

model SecurityAuditEvent {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String                 @map("workspace_id") @db.Uuid
  actorUserId String?                @map("actor_user_id") @db.Uuid
  eventKind   SecurityAuditEventKind @map("event_kind")
  metadata    Json                   @db.JsonB
  createdAt   DateTime               @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict, map: "security_audit_events_workspace_id_fkey")
  actor       User?                  @relation("SecurityAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "security_audit_events_actor_user_id_fkey")

  @@index([workspaceId, createdAt(sort: Desc)], map: "security_audit_events_workspace_created_at_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "security_audit_events_actor_created_at_idx")
  @@map("security_audit_events")
}

model WorkspaceMembership {
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "workspace_memberships_workspace_id_fkey")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "workspace_memberships_user_id_fkey")
  teams       TeamMembership[]

  @@id([workspaceId, userId], map: "workspace_memberships_pkey")
  @@unique([workspaceId, userId, role], map: "workspace_memberships_workspace_id_user_id_role_key")
  @@map("workspace_memberships")
}

model Team {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  name        String
  key         String
  visibility  String           @default("workspace")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "teams_workspace_id_fkey")
  memberships TeamMembership[]

  @@unique([workspaceId, id], map: "teams_workspace_id_id_key")
  @@unique([workspaceId, key], map: "teams_workspace_id_key_key")
  @@map("teams")
}

model TeamMembership {
  workspaceId String @map("workspace_id") @db.Uuid
  teamId      String @map("team_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  team        Team @relation(fields: [workspaceId, teamId], references: [workspaceId, id], onDelete: Cascade, map: "team_memberships_workspace_id_team_id_fkey")
  membership  WorkspaceMembership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade, map: "team_memberships_workspace_id_user_id_fkey")

  @@id([teamId, userId], map: "team_memberships_pkey")
  @@map("team_memberships")
}

model Invitation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  email      String
  role       String
  tokenHash  Bytes    @unique(map: "invitations_token_hash_key") @map("token_hash") @db.ByteA
  invitedBy  String   @map("invited_by") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  redeemedAt DateTime? @map("redeemed_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "invitations_workspace_id_fkey")
  inviter    User      @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: NoAction, map: "invitations_invited_by_fkey")

  @@map("invitations")
}
