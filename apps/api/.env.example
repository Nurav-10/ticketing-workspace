NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://ticketing:local-development-only@db:5432/ticketing
DATABASE_POOL_MAX=10
SESSION_COOKIE_NAME=app_session
PUBLIC_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=false
# Hosted sign-in is optional in development and requires HTTPS plus all settings below.
# OIDC_ISSUER=https://identity.example/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_CALLBACK_URI=https://app.example/api/v1/auth/callback
# SESSION_COOKIE_NAME=__Host-ticketing_session
# OIDC_TRANSACTION_ENCRYPTION_KEY=<independent-32-byte-base64url-secret>
# RATE_LIMIT_HMAC_KEY=<different-independent-32-byte-base64url-secret>
# First-workspace setup is optional and requires all three settings. The grant hash
# is SHA-256 of the decoded 32-byte operator secret, encoded as base64url.
# BOOTSTRAP_GRANT_HASH=
# BOOTSTRAP_WORKSPACE_NAME=
# BOOTSTRAP_WORKSPACE_SLUG=
# Optional: independent 32-byte base64url bearer secret for the /metrics endpoint.
# METRICS_BEARER_TOKEN=
